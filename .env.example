# 複製這個檔案為 .env,並修改下面的值

# 進入網站需要的帳號密碼(多組帳號用逗號分隔,格式:帳號:密碼,帳號:密碼)
ACCOUNTS=admin:changeme

# 舊版單一帳密設定(ACCOUNTS 有值時會被忽略,留著僅供備用/相容)
ACCESS_USERNAME=admin
ACCESS_PASSWORD=changeme

# session 加密用的亂數字串(自己隨便打一串長字串)
SESSION_SECRET=please-change-this-to-a-random-long-string

# 網站監聽的埠號
PORT=3000

# SumatraPDF.exe 的完整路徑(用來靜默列印 PDF)
SUMATRA_PATH=C:\Users\xun\AppData\Local\SumatraPDF\SumatraPDF.exe

# LibreOffice soffice.exe 的完整路徑(用來把 Word 轉成 PDF)
SOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe

# 浮水印/頁碼/測試頁/貼上文字列印功能需要的中文字型(.ttf 檔案路徑)
# 預設會自動找 Windows 內建的標楷體,通常不用改這行
CJK_FONT_PATH=C:\Windows\Fonts\kaiu.ttf

# Microsoft Edge 的完整路徑(用來把網頁轉成 PDF),通常不用改這行
EDGE_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe

# 印表機累積列印超過幾頁要提醒檢查耗材/保養(預設 1000)
MAINTENANCE_THRESHOLD=1000

# 對外的固定網址(QR Code 快速開啟工具頁會用到)
PUBLIC_URL=https://your-domain.example.com/print/

# qpdf.exe 的完整路徑(用來解鎖有密碼保護的 PDF)
QPDF_PATH=C:\Program Files\qpdf\bin\qpdf.exe
